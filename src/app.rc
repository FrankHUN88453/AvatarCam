#include <winres.h>
#include "core/Version.h"

1 24 "app.manifest"
2 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AVATARCAM_VERSION_NUM
 PRODUCTVERSION AVATARCAM_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AvatarCam"
            VALUE "FileDescription", "AvatarCam - VRChat avatar virtual camera"
            VALUE "FileVersion", AVATARCAM_VERSION
            VALUE "InternalName", "AvatarCam"
            VALUE "OriginalFilename", "AvatarCam.exe"
            VALUE "ProductName", "AvatarCam"
            VALUE "ProductVersion", AVATARCAM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
